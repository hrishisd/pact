# Copy to .env for `npm run dev` (it's gitignored). In development every value
# has a default, but real Google sign-in needs the Google client below.
# In production (NODE_ENV=production) every variable marked "required" must be
# set, or the server refuses to start. On Fly, they are Fly secrets or [env] in fly.toml.

# Port the server listens on. Dev: 3000 (Vite on 5173 proxies to it). Fly: 8080.
PORT=3000

# Required. SQLite file shared by the Pact core and Better Auth. Prod: /data/pact.db
# Dev: .dev-data.nosync, because iCloud Drive (the repo is in ~/Documents) skips .nosync names.
PACT_DB_PATH=.dev-data.nosync/pact.db

# Required. Your Google account's email: the one account that needs no invite.
OPERATOR_EMAIL=you@gmail.com

# Required. Google OAuth client (Web application). Authorized redirect URIs:
#   https://pact.hrishisd.com/api/auth/callback/google
#   http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required. Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. The origin the browser uses. Dev: the Vite server. Prod: https://pact.hrishisd.com
BETTER_AUTH_URL=http://localhost:5173

# Required in production. The private Cloudflare R2 bucket for evidence photos, and keys
# scoped to it (Object Read & Write). Development ignores these and keeps photos on
# local disk in photos/ next to PACT_DB_PATH (.dev-data.nosync/photos), so it needs no bucket.
# PHOTOS_BUCKET=pact-photos
# PHOTOS_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# PHOTOS_ACCESS_KEY_ID=
# PHOTOS_SECRET_ACCESS_KEY=

# Required in production. The VAPID key pair that signs Web Push, base64url. Development has
# its own defaults. Generate a pair with:
#   node -e 'const e=require("crypto").createECDH("prime256v1");e.generateKeys();console.log("VAPID_PUBLIC_KEY="+e.getPublicKey("base64url")+"\nVAPID_PRIVATE_KEY="+e.getPrivateKey("base64url"))'
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Required in production. The Oura OAuth app (cloud.ouraring.com/oauth/applications), scope daily.
# Redirect URIs: https://pact.hrishisd.com/api/oura/callback and http://localhost:5173/api/oura/callback
# OURA_TOKEN_KEY encrypts Oura's tokens in the database. Generate with: openssl rand -base64 32
# Development without OURA_CLIENT_ID connects without Oura, and reads sleep periods (Oura's shape)
# from oura-sleep.json next to PACT_DB_PATH.
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# OURA_TOKEN_KEY=

# Container only (read by Litestream, not the app). Cloudflare R2 bucket and keys.
# LITESTREAM_BUCKET=pact-litestream
# LITESTREAM_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Set by the container entrypoint, never by hand: 1 when Litestream restored the database on this boot.
# PACT_RESTORED=1

# Set at image build by CI, never by hand: the commit /health reports. Unset, /health reports null.
# PACT_COMMIT=
