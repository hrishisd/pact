# Copy to .env for `npm run dev` (it's gitignored). In development every value
# has a default, but real Google sign-in needs the Google client below.
# In production (NODE_ENV=production) every variable marked "required" must be
# set, or the server refuses to start. On Fly, they are Fly secrets or [env] in fly.toml.

# Port the server listens on. Dev: 3000 (Vite on 5173 proxies to it). Fly: 8080.
PORT=3000

# Required. SQLite file shared by the Pact core and Better Auth. Prod: /data/pact.db
# Dev: .dev-data.nosync, because iCloud Drive (the repo is in ~/Documents) skips .nosync names.
PACT_DB_PATH=.dev-data.nosync/pact.db

# Required. Your Google account's email: the one account that needs no invite.
OPERATOR_EMAIL=you@gmail.com

# Required. Google OAuth client (Web application). Authorized redirect URIs:
#   https://pact.hrishisd.com/api/auth/callback/google
#   http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required. Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. The origin the browser uses. Dev: the Vite server. Prod: https://pact.hrishisd.com
BETTER_AUTH_URL=http://localhost:5173

# Container only (read by Litestream, not the app). Cloudflare R2 bucket and keys.
# LITESTREAM_BUCKET=pact-litestream
# LITESTREAM_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Set by the container entrypoint, never by hand: 1 when Litestream restored the database on this boot.
# PACT_RESTORED=1
