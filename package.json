{
  "name": "pact",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check . && knip && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-conventions.ts && shellcheck scripts/*.sh .claude/hooks/*.sh .githooks/*",
    "icons": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-icons.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
